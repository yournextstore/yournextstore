{
  "name": "yournextstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun next dev",
    "build": "bun next build && bash scripts/check-shell.sh",
    "start": "bun next start",
    "prepare": "husky",
    "lint": "bun run biome check --write --unsafe",
