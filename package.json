{
  "name": "yournextstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun next dev",
    "build": "bun next build && bash scripts/check-shell.sh",
    "start": "bun next start",
    "prepare": "husky",
    "lint": "bun run biome check --write --unsafe",
    "publish:store": "bash scripts/publish.sh",
    "api": "bash scripts/api.sh",
    "test": "bun test",
    "format": "bun run biome format --write",
    "check": "bun run biome check && bun tsc --noEmit && bun test",
    "audit": "bash scripts/audit.sh"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.156",
    "@base-ui/react": "1.9.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-youtube": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "ai": "7.0.152",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "commerce-kit": "0.72.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "safe-try": "0.0.4",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2"
  }
}
